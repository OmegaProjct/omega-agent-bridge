{
  "name": "omega-agent-bridge",
  "version": "0.2.0",
  "description": "Local orchestration bridge that delegates bounded engineering work to agy, Claude Code, or Codex with isolated accounts and cross-engine review.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "omega-agent-bridge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "skills": "node ./scripts/generate-skills.mjs",
    "build": "npm run clean && npm run skills && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "account:login": "node ./dist/cli.js account login",
    "account:list": "node ./dist/cli.js account list",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "bridge",
    "cli",
    "automation",
    "orchestration",
    "antigravity",
    "claude",
    "codex"
  ],
  "dependencies": {
    "commander": "^14.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
